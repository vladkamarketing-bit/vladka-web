---
// Návrh úvodní stránky pro chovatelskou stanici Bellarmin (klientka Hedvika) – varianta 3:
// nový grafický styl (světlý, vzdušný, oblouky, jemné linky) v hnědých tónech varianty 2.
const img = '/images/hedvika';
const nav = [
  { href: '#chov', label: 'Chov' },
  { href: '#handling', label: 'Handling' },
  { href: '#hlidani', label: 'Hlídání' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Bellarmin — chovatelská stanice</title>
    <meta name="description" content="Chovatelská stanice Bellarmin: odpovědný chov, profesionální handling na výstavách a hlídání psů v rodinném prostředí." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- HLAVIČKA -->
    <header class="top" id="top">
      <nav class="nav nav-left" aria-label="Služby">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a href="#top" class="logo" aria-label="Bellarmin – úvod">
        <span class="logo-name">Bellarmin</span>
        <span class="logo-sub">chovatelská stanice</span>
      </a>
      <div class="nav-right">
        <a href="#pristup" class="nav-link">O stanici</a>
        <a href="#kontakt" class="pill pill-dark pill-sm">Kontakt</a>
      </div>
      <button class="burger" aria-label="Otevřít menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span>
      </button>
    </header>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobilní navigace">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="#pristup">O stanici</a>
      <a href="#kontakt" class="pill pill-dark">Kontakt</a>
    </nav>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-text">
            <p class="label">Chovatelská stanice · od štěněte po šampiona</p>
            <h1>Přátelský<br /><span class="soft">charakter</span></h1>
            <p class="lead">
              Vychováváme štěňata pro život, vodíme psy k úspěchům na výstavách
              a staráme se o ně, když vy nemůžete. Se stejnou péčí a respektem.
            </p>
            <div class="actions">
              <a href="#chov" class="pill pill-dark">Plánované vrhy</a>
              <a href="#sluzby" class="pill pill-line">Co nabízíme</a>
            </div>
          </div>
          <div class="hero-visual">
            <div class="arch arch-hero">
              <img src={`${img}/hero-setr.webp`} alt="Chovatelka se setrem u vody na podzim" width="828" height="536" fetchpriority="high" />
            </div>
            <span class="arch-outline" aria-hidden="true"></span>
            <svg class="badge" viewBox="0 0 200 200" aria-hidden="true">
              <defs><path id="circ" d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0" /></defs>
              <circle cx="100" cy="100" r="98" />
              <text><textPath href="#circ" textLength="446" lengthAdjust="spacingAndGlyphs">BELLARMIN · CHOV · HANDLING · HLÍDÁNÍ · </textPath></text>
              <g class="badge-paw" transform="translate(100 104)">
                <ellipse cx="0" cy="8" rx="13" ry="11" />
                <ellipse cx="-15" cy="-8" rx="5.5" ry="7" />
                <ellipse cx="-5" cy="-17" rx="5.5" ry="7" />
                <ellipse cx="6" cy="-17" rx="5.5" ry="7" />
                <ellipse cx="16" cy="-8" rx="5.5" ry="7" />
              </g>
            </svg>
          </div>
        </div>
      </section>

      <!-- TŘI SLUŽBY -->
      <section class="services" id="sluzby" aria-labelledby="services-title">
        <div class="wrap">
          <header class="services-head">
            <h2 id="services-title">Tři služby, jeden přístup</h2>
            <p>Chováme, předvádíme i hlídáme se stejnou péčí – zdraví a pohoda psa jsou vždy na prvním místě.</p>
          </header>
          <ul class="service-row">
            <li>
              <a href="#chov">
                <svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="24" cy="30" rx="9" ry="8" /><ellipse cx="13" cy="19" rx="3.6" ry="4.6" /><ellipse cx="20" cy="12.5" rx="3.6" ry="4.6" /><ellipse cx="28" cy="12.5" rx="3.6" ry="4.6" /><ellipse cx="35" cy="19" rx="3.6" ry="4.6" /></svg>
                <span>Chov</span>
              </a>
            </li>
            <li>
              <a href="#handling">
                <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="18" r="11" /><circle cx="24" cy="18" r="5" /><path d="M17 27 L13 42 L19 39 L22 44 L24 29 M31 27 L35 42 L29 39 L26 44 L24 29" /></svg>
                <span>Handling</span>
              </a>
            </li>
            <li>
              <a href="#hlidani">
                <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M7 23 L24 9 L41 23" /><path d="M12 20 V40 H36 V20" /><path d="M20 40 V30 a4 4 0 0 1 8 0 V40" /></svg>
                <span>Hlídání</span>
              </a>
            </li>
          </ul>
        </div>
      </section>

      <!-- CHOV -->
      <section class="block chov" id="chov" aria-labelledby="chov-title">
        <div class="wrap split">
          <div class="split-photo">
            <div class="arch">
              <img src={`${img}/chov-svycarsky-pes.webp`} alt="Velký švýcarský salašnický pes s chovatelkou v zimní krajině" width="824" height="984" loading="lazy" />
            </div>
          </div>
          <div class="split-text">
            <p class="label">Chov</p>
            <h2 id="chov-title">Chováme méně.<br /><span class="soft">Zato pořádně.</span></h2>
            <p class="body">
              Každé spojení plánujeme s ohledem na zdraví, povahu a exteriér.
              Štěňata vyrůstají v rodině, poznávají běžný svět od prvních týdnů
              a k novým majitelům odcházejí sebevědomá a socializovaná.
            </p>
            <dl class="facts">
              <div><dt>Zdraví</dt><dd>Zdravotně testovaní rodiče s doloženými výsledky</dd></div>
              <div><dt>Socializace</dt><dd>Od narození – zvuky, lidé, cestování</dd></div>
              <div><dt>Podpora</dt><dd>I po odběru – jsme tu na telefonu celý psí život</dd></div>
            </dl>
            <div class="actions">
              <a href="#kontakt" class="pill pill-dark">Zájem o štěně</a>
              <a href="#kontakt" class="text-link">Naši psi a fenky</a>
            </div>
          </div>
        </div>
      </section>

      <!-- HANDLING -->
      <section class="block handling" id="handling" aria-labelledby="handling-title">
        <div class="wrap split split-reverse">
          <div class="split-photo">
            <div class="arch arch-light">
              <img src={`${img}/handling-vystava.webp`} alt="Handlerka se setrem a výstavní rozetou před zámkem" width="828" height="1444" loading="lazy" />
            </div>
          </div>
          <div class="split-text">
            <p class="label label-light">Handling</p>
            <h2 id="handling-title">V kruhu rozhoduje<br /><span class="soft">každá vteřina.</span></h2>
            <p class="body">
              Výstava není jen o krásném psovi. Je o přípravě, kondici, úpravě
              srsti a klidné ruce, která psa ukáže v nejlepším světle.
              To vše za vás převezmeme – od tréninku až po kruh.
            </p>
            <ol class="path">
              <li><strong>Konzultace</strong><span>posouzení psa a plán</span></li>
              <li><strong>Příprava</strong><span>trénink a úprava srsti</span></li>
              <li><strong>Výstava</strong><span>předvedení v kruhu</span></li>
            </ol>
            <div class="actions">
              <a href="#kontakt" class="pill pill-beige">Domluvit handling</a>
              <a href="#kontakt" class="text-link text-link-light">Výstavní kalendář</a>
            </div>
          </div>
        </div>
      </section>

      <!-- HLÍDÁNÍ -->
      <section class="block hlidani" id="hlidani" aria-labelledby="hlidani-title">
        <div class="wrap">
          <header class="center-head">
            <p class="label">Hlídání psů</p>
            <h2 id="hlidani-title">Odjeďte v klidu. <span class="soft">Tady je jako doma.</span></h2>
          </header>
          <div class="stay">
            <figure class="stay-photo">
              <img src={`${img}/hlidani-pelisky.webp`} alt="Psi odpočívají na pelíšcích v místnosti s výstavními trofejemi" width="828" height="563" loading="lazy" />
            </figure>
            <div class="stay-card">
              <p>
                Hlídáme jen tolik psů, kolik zvládneme opravdu dobře. Mají své
                pelíšky, společnost a denní program – a vy každý den fotku,
                že je všechno v pořádku.
              </p>
              <ul>
                <li>Rodinné prostředí, žádné kotce</li>
                <li>Malá skupina psů</li>
                <li>Zprávy a fotky každý den</li>
                <li>Zkušenost s různými plemeny</li>
              </ul>
              <a href="#kontakt" class="pill pill-dark">Ověřit volný termín</a>
            </div>
          </div>
        </div>
      </section>

      <!-- PŘÍSTUP -->
      <section class="quote" id="pristup" aria-labelledby="quote-title">
        <div class="wrap quote-inner">
          <span class="quote-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <h2 id="quote-title">
            Pes není výstavní exponát ani projekt. Je to parťák, který si zaslouží
            to nejlepší – <span class="soft">doma, v kruhu i na cestách.</span>
          </h2>
          <ul class="values">
            <li>Zdraví na prvním místě</li>
            <li>Povaha stejně důležitá jako vzhled</li>
            <li>Respekt ke psům i jejich lidem</li>
          </ul>
        </div>
      </section>

      <!-- KONTAKT -->
      <section class="contact" id="kontakt" aria-labelledby="contact-title">
        <div class="wrap">
          <div class="contact-card">
            <div class="contact-info">
              <p class="label">Kontakt</p>
              <h2 id="contact-title">Napište nám.<br /><span class="soft">Ozveme se do 24 hodin.</span></h2>
              <ul class="contact-list">
                <li><span>Telefon</span><a href="tel:+420000000000">+420 000 000 000</a></li>
                <li><span>E-mail</span><a href="mailto:info@bellarmin.cz">info@bellarmin.cz</a></li>
                <li><span>Lokalita</span>Doplnit obec, Česká republika</li>
              </ul>
            </div>
            <form class="form" onsubmit="event.preventDefault(); this.querySelector('.form-ok').hidden = false;">
              <fieldset class="chips">
                <legend>Mám zájem o</legend>
                <label><input type="radio" name="topic" value="chov" checked /><span>Štěně</span></label>
                <label><input type="radio" name="topic" value="handling" /><span>Handling</span></label>
                <label><input type="radio" name="topic" value="hlidani" /><span>Hlídání</span></label>
              </fieldset>
              <label class="field"><span>Jméno</span><input type="text" name="name" autocomplete="name" required /></label>
              <label class="field"><span>E-mail nebo telefon</span><input type="text" name="contact" required /></label>
              <label class="field"><span>Zpráva</span><textarea name="message" rows="3" placeholder="Plemeno, věk psa, termín…"></textarea></label>
              <button type="submit" class="pill pill-dark pill-block">Odeslat zprávu</button>
              <p class="form-ok" hidden>Děkujeme, zpráva je na cestě. (ukázka – formulář zatím nic neodesílá)</p>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <a href="#top" class="logo logo-foot">
          <span class="logo-name">Bellarmin</span>
          <span class="logo-sub">chovatelská stanice</span>
        </a>
        <nav aria-label="Patička">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="#pristup">O stanici</a>
          <a href="#kontakt">Kontakt</a>
        </nav>
        <p>© {new Date().getFullYear()} Bellarmin · chovatelská stanice registrovaná pod ČMKU / FCI</p>
      </div>
    </footer>

    <script is:inline>
      const burger = document.querySelector('.burger');
      const mnav = document.getElementById('mobile-nav');
      const toggle = (open) => {
        burger.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-open', open);
      };
      burger.addEventListener('click', () => toggle(burger.getAttribute('aria-expanded') !== 'true'));
      mnav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggle(false)));
      const topBar = document.querySelector('.top');
      const onScroll = () => topBar.classList.toggle('scrolled', window.scrollY > 30);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>

    <style is:global>
      :root {
        --espresso: #3d291b;
        --brown: #593a24;
        --tone-1: #8a5a36; /* oříšková hnědá */
        --tone-2: #b48a62; /* světle hnědá */
        --tone-3: #dcc5a8; /* béžová */
        --sand: #efe3d1;
        --cream: #faf4e9;
        --white: #ffffff;
        --font: 'Jost', system-ui, sans-serif;
        --gutter: clamp(16px, 4vw, 56px);
        --line: rgba(61, 41, 27, 0.16);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 90px; }
      body {
        margin: 0; background: var(--cream); color: var(--espresso);
        font-family: var(--font); font-size: 17px; font-weight: 400; line-height: 1.7;
        -webkit-font-smoothing: antialiased; overflow-x: hidden;
      }
      img { display: block; max-width: 100%; }
      a { color: inherit; }
      p { margin: 0; }
      h1, h2, h3 { font-weight: 300; letter-spacing: -0.02em; line-height: 1.05; margin: 0; }
      h2 { font-size: clamp(2.2rem, 4.4vw, 3.6rem); }
      .soft { color: var(--tone-1); font-weight: 300; }
      .wrap { max-width: 1240px; margin: 0 auto; padding: 0 var(--gutter); }

      .label {
        font-size: 0.74rem; font-weight: 500; letter-spacing: 0.32em; text-transform: uppercase;
        color: var(--tone-1); margin-bottom: 1.4rem;
      }
      .label-light { color: var(--tone-3); }

      /* Tlačítka */
      .pill {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0.95rem 2rem; border-radius: 999px; border: 1px solid transparent;
        font: 500 0.82rem/1 var(--font); letter-spacing: 0.18em; text-transform: uppercase;
        text-decoration: none; cursor: pointer; transition: background 0.25s, color 0.25s, border-color 0.25s;
      }
      .pill-sm { padding: 0.7rem 1.4rem; font-size: 0.74rem; }
      .pill-dark { background: var(--espresso); color: var(--cream); }
      .pill-dark:hover { background: var(--tone-1); }
      .pill-line { border-color: var(--espresso); color: var(--espresso); }
      .pill-line:hover { background: var(--espresso); color: var(--cream); }
      .pill-beige { background: var(--tone-3); color: var(--espresso); }
      .pill-beige:hover { background: var(--cream); }
      .pill-block { width: 100%; }
      .text-link {
        font-size: 0.82rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
        text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
        padding-bottom: 4px; transition: background-size 0.3s;
      }
      .text-link:hover { background-size: 40% 1px; }
      .text-link-light { color: var(--tone-3); }
      .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.1rem 1.8rem; }

      /* Hlavička */
      .top {
        position: fixed; inset: 0 0 auto 0; z-index: 50;
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
        padding: 1.2rem var(--gutter); background: rgba(250, 244, 233, 0.92);
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid transparent; transition: border-color 0.3s, padding 0.3s;
      }
      .top.scrolled { border-bottom-color: var(--line); padding-top: 0.8rem; padding-bottom: 0.8rem; }
      .nav { display: flex; gap: 2.2rem; }
      .nav a, .nav-link {
        font-size: 0.8rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none;
        transition: color 0.2s;
      }
      .nav a:hover, .nav-link:hover { color: var(--tone-1); }
      .nav-right { display: flex; justify-content: flex-end; align-items: center; gap: 2rem; }
      .logo { display: flex; flex-direction: column; align-items: center; text-decoration: none; line-height: 1; }
      .logo-name { font-size: 1.6rem; font-weight: 400; letter-spacing: 0.34em; text-transform: uppercase; margin-right: -0.34em; }
      .logo-sub { font-size: 0.62rem; letter-spacing: 0.36em; text-transform: uppercase; color: var(--tone-1); margin-top: 0.45rem; margin-right: -0.36em; }
      .burger { display: none; justify-self: end; background: none; border: 0; padding: 10px; cursor: pointer; }
      .burger span { display: block; width: 26px; height: 1.5px; background: var(--espresso); margin: 6px 0; transition: transform 0.25s; }
      .menu-open .burger span:first-child { transform: translateY(3.75px) rotate(45deg); }
      .menu-open .burger span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
      .mobile-nav {
        position: fixed; inset: 0; z-index: 40; background: var(--cream);
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem;
        opacity: 0; pointer-events: none; transition: opacity 0.3s;
      }
      .mobile-nav a:not(.pill) { font-size: 1.9rem; font-weight: 300; text-decoration: none; }
      .menu-open .mobile-nav { opacity: 1; pointer-events: auto; }

      /* Hero */
      .hero { padding: clamp(8rem, 13vw, 10.5rem) 0 clamp(4rem, 7vw, 6rem); position: relative; }
      .hero::before {
        content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 38%;
        background: var(--sand); z-index: -1;
      }
      .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
      .hero h1 { font-size: clamp(3.4rem, 7.6vw, 7rem); font-weight: 300; line-height: 0.98; letter-spacing: -0.035em; margin-bottom: 2rem; }
      .hero h1 .soft { font-weight: 300; color: var(--tone-2); }
      .lead { font-size: 1.1rem; max-width: 31rem; color: var(--brown); margin-bottom: 2.6rem; }
      .hero-visual { position: relative; justify-self: center; width: min(100%, 470px); }
      .arch { border-radius: 1000px 1000px 0 0; overflow: hidden; aspect-ratio: 4 / 5; background: var(--tone-3); }
      .arch img { width: 100%; height: 100%; object-fit: cover; }
      .arch-hero img { object-position: 63% 50%; }
      .arch-outline {
        position: absolute; inset: -16px -16px 16px 16px; border: 1px solid var(--tone-2);
        border-radius: 1000px 1000px 0 0; pointer-events: none; z-index: -1;
      }
      .badge {
        position: absolute; left: -64px; bottom: 36px; width: 132px; height: 132px;
        animation: spin 28s linear infinite;
      }
      .badge circle { fill: var(--espresso); }
      .badge text { fill: var(--tone-3); font: 500 15.5px var(--font); letter-spacing: 0.12em; }
      .badge-paw { fill: var(--tone-2); }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* Tři služby */
      .services { padding: clamp(2.8rem, 5vw, 3.8rem) 0; background: var(--white); border-block: 1px solid var(--line); }
      .services-head { text-align: center; max-width: 40rem; margin: 0 auto 2rem; }
      .services-head h2 { font-size: clamp(1.7rem, 3vw, 2.3rem); margin-bottom: 0.6rem; }
      .services-head p { color: var(--brown); font-size: 0.98rem; }
      .service-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .service-row li + li { border-left: 1px solid var(--line); }
      .service-row a {
        display: flex; align-items: center; justify-content: center; gap: 1rem;
        padding: 1rem; text-decoration: none; transition: color 0.25s;
      }
      .service-row svg { width: 44px; height: 44px; fill: none; stroke: var(--tone-2); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; transition: stroke 0.25s, transform 0.3s; }
      .service-row span { font-size: clamp(1.5rem, 2.4vw, 1.9rem); font-weight: 300; letter-spacing: -0.01em; }
      .service-row a:hover { color: var(--tone-1); }
      .service-row a:hover svg { stroke: var(--tone-1); transform: translateY(-3px); }

      /* Bloky služeb */
      .block { padding: clamp(5rem, 10vw, 8.5rem) 0; }
      .split { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(3rem, 8vw, 7.5rem); align-items: center; }
      .split-reverse { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
      .split-reverse .split-photo { order: 2; }
      .split-photo { position: relative; max-width: 470px; width: 100%; justify-self: center; }
      .split-text h2 { margin-bottom: 1.6rem; }
      .body { color: var(--brown); max-width: 34rem; margin-bottom: 2.4rem; }
      .facts { margin: 0 0 2.6rem; border-top: 1px solid var(--line); }
      .facts div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
      .facts dt { font-size: 0.74rem; font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase; color: var(--tone-1); padding-top: 0.2rem; }
      .facts dd { margin: 0; }

      .handling { background: var(--brown); color: var(--cream); }
      .handling .soft { color: var(--tone-3); }
      .handling .body { color: rgba(250, 244, 233, 0.78); }
      .arch-light { background: var(--tone-1); }
      .arch-light img { object-position: 50% 62%; }
      .path { list-style: none; margin: 0 0 2.6rem; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; position: relative; }
      .path::before { content: ''; position: absolute; left: 0; right: 0; top: 7px; height: 1px; background: rgba(220, 197, 168, 0.35); }
      .path li { position: relative; padding-top: 2rem; display: flex; flex-direction: column; }
      .path li::before {
        content: ''; position: absolute; left: 0; top: 0; width: 15px; height: 15px; border-radius: 50%;
        background: var(--brown); border: 1px solid var(--tone-3);
      }
      .path li:last-child::before { background: var(--tone-3); }
      .path strong { font-weight: 400; font-size: 1.25rem; }
      .path span { font-size: 0.92rem; color: rgba(250, 244, 233, 0.65); }

      .center-head { text-align: center; margin-bottom: 3rem; }
      .center-head .label { margin-bottom: 1rem; }
      .stay { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); align-items: center; }
      .stay-photo { margin: 0; border-radius: 28px; overflow: hidden; aspect-ratio: 4 / 3; }
      .stay-photo img { width: 100%; height: 100%; object-fit: cover; }
      .stay-card {
        background: var(--white); border-radius: 28px; padding: clamp(1.8rem, 3.5vw, 3rem);
        margin-left: -4rem; position: relative; box-shadow: 0 30px 60px -30px rgba(61, 41, 27, 0.28);
      }
      .stay-card p { color: var(--brown); margin-bottom: 1.6rem; }
      .stay-card ul { list-style: none; padding: 0; margin: 0 0 2rem; }
      .stay-card li { padding: 0.7rem 0 0.7rem 1.8rem; border-bottom: 1px solid var(--line); position: relative; }
      .stay-card li::before { content: ''; position: absolute; left: 0; top: 50%; width: 9px; height: 9px; border-radius: 50%; background: var(--tone-2); transform: translateY(-50%); }
      .stay-card li:nth-child(2)::before { background: var(--tone-1); }
      .stay-card li:nth-child(3)::before { background: var(--tone-3); }
      .stay-card li:nth-child(4)::before { background: var(--brown); }

      /* Citát */
      .quote { background: var(--sand); padding: clamp(5rem, 10vw, 8rem) 0; text-align: center; }
      .quote-inner { max-width: 1000px; }
      .quote-mark { display: flex; justify-content: center; gap: 6px; margin-bottom: 2.4rem; }
      .quote-mark i { width: 34px; height: 3px; border-radius: 3px; background: var(--tone-1); }
      .quote-mark i:nth-child(2) { background: var(--tone-2); }
      .quote-mark i:nth-child(3) { background: var(--tone-3); }
      .quote h2 { font-size: clamp(1.7rem, 3.4vw, 2.7rem); line-height: 1.25; letter-spacing: -0.015em; margin-bottom: 3rem; }
      .values { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.7rem; }
      .values li { padding: 0.6rem 1.3rem; border: 1px solid var(--tone-2); border-radius: 999px; font-size: 0.92rem; color: var(--brown); }

      /* Kontakt */
      .contact { padding: clamp(5rem, 10vw, 8rem) 0; }
      .contact-card {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 5rem);
        background: var(--white); border-radius: 36px; padding: clamp(1.8rem, 5vw, 4.5rem);
        border: 1px solid var(--line);
      }
      .contact h2 { font-size: clamp(2rem, 3.6vw, 3rem); margin-bottom: 2.4rem; }
      .contact-list { list-style: none; padding: 0; margin: 0; }
      .contact-list li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
      .contact-list span { font-size: 0.72rem; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--tone-1); padding-top: 0.25rem; }
      .contact-list a { text-decoration: none; }
      .contact-list a:hover { color: var(--tone-1); }
      .form { display: grid; gap: 1.1rem; align-content: start; }
      .chips { border: 0; padding: 0; margin: 0 0 0.4rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .chips legend, .field span { font-size: 0.72rem; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--tone-1); margin-bottom: 0.7rem; }
      .chips input { position: absolute; opacity: 0; }
      .chips span { display: inline-block; padding: 0.55rem 1.2rem; border-radius: 999px; border: 1px solid var(--tone-3); font-size: 0.92rem; cursor: pointer; transition: background 0.2s; }
      .chips input:checked + span { background: var(--tone-3); border-color: var(--tone-3); }
      .chips input:focus-visible + span { outline: 2px solid var(--tone-1); outline-offset: 2px; }
      .field { display: grid; }
      .field span { margin-bottom: 0.45rem; }
      .field input, .field textarea {
        font: inherit; color: inherit; background: var(--cream); border: 1px solid transparent;
        border-radius: 18px; padding: 0.85rem 1.1rem; resize: vertical; transition: border-color 0.2s;
      }
      .field input:focus, .field textarea:focus { outline: none; border-color: var(--tone-2); }
      .form-ok { color: var(--tone-1); font-weight: 500; }

      /* Patička */
      .foot { padding: 3.5rem 0 2.5rem; border-top: 1px solid var(--line); text-align: center; }
      .foot-inner { display: flex; flex-direction: column; align-items: center; gap: 1.8rem; }
      .foot nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem 2rem; }
      .foot nav a { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; text-decoration: none; }
      .foot nav a:hover { color: var(--tone-1); }
      .foot p { font-size: 0.8rem; color: var(--tone-1); }

      /* Responsivita */
      @media (max-width: 980px) {
        .top { grid-template-columns: 1fr auto; }
        .nav-left, .nav-right { display: none; }
        .logo { align-items: flex-start; }
        .burger { display: block; }
        .hero::before { width: 100%; top: auto; height: 42%; }
        .hero-grid, .split, .split-reverse, .contact-card { grid-template-columns: 1fr; }
        .hero-visual { width: min(82%, 420px); margin-top: 1rem; }
        .split-reverse .split-photo { order: 0; }
        .split-photo { max-width: 420px; }
        .stay { grid-template-columns: 1fr; }
        .stay-card { margin: -3rem 1rem 0; }
      }
      @media (max-width: 560px) {
        body { font-size: 16px; }
        .logo-name { font-size: 1.3rem; }
        .badge { left: -28px; bottom: 20px; width: 100px; height: 100px; }
        .service-row { grid-template-columns: 1fr; }
        .service-row li + li { border-left: 0; border-top: 1px solid var(--line); }
        .service-row a { justify-content: flex-start; padding: 0.9rem 0.25rem; }
        .service-row svg { width: 36px; height: 36px; }
        .facts div, .contact-list li { grid-template-columns: 1fr; gap: 0.2rem; }
        .path { grid-template-columns: 1fr; gap: 1.2rem; }
        .path::before { left: 7px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
        .path li { padding: 0 0 0 2rem; }
        .stay-card { margin: -2rem 0.5rem 0; }
        .contact-card { border-radius: 24px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .badge { animation: none; }
        * { transition: none !important; }
      }
    </style>
  </body>
</html>
