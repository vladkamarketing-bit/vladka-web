---
// Návrh úvodní stránky pro chovatelskou stanici Bellarmin (klientka Hedvika) – varianta 8:
// barvy a písmo varianty 1 (Styl 7 „Sportovní srdce“, Oswald + Manrope), nová grafika bez číslic:
// šikmé řezy, ikony v rozetách (motiv výstavní stuhy), oranžový pás s citátem, jemné animace.
const img = '/images/hedvika';
const nav = [
  { href: '#chov', label: 'Chov' },
  { href: '#handling', label: 'Handling' },
  { href: '#hlidani', label: 'Hlídání' },
  { href: '#pristup', label: 'O stanici' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Bellarmin — chovatelská stanice</title>
    <meta name="description" content="Chovatelská stanice Bellarmin: odpovědný chov, profesionální handling na výstavách a hlídání psů v rodinném prostředí." />
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(() => { if (!window.__b8Ready) document.documentElement.classList.remove('js'); }, 2500);
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Sada ikon -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-paw" viewBox="0 0 48 48"><ellipse cx="24" cy="31" rx="9.5" ry="8.5" /><ellipse cx="12.5" cy="19.5" rx="4" ry="5.2" /><ellipse cx="19.5" cy="12" rx="4" ry="5.2" /><ellipse cx="28.5" cy="12" rx="4" ry="5.2" /><ellipse cx="35.5" cy="19.5" rx="4" ry="5.2" /></symbol>
      <symbol id="i-rosette" viewBox="0 0 48 48"><circle cx="24" cy="18" r="11" /><circle cx="24" cy="18" r="5" /><path d="M17 27 L13 43 L19 40 L22 45 L24 29 M31 27 L35 43 L29 40 L26 45 L24 29" /></symbol>
      <symbol id="i-home" viewBox="0 0 48 48"><path d="M7 23 L24 9 L41 23" /><path d="M12 20 V40 H36 V20" /><path d="M20 40 V30 a4 4 0 0 1 8 0 V40" /></symbol>
      <symbol id="i-heart" viewBox="0 0 48 48"><path d="M24 40 C10 30 6 23 6 17 a8.5 8.5 0 0 1 18 -3 a8.5 8.5 0 0 1 18 3 c0 6 -4 13 -18 23z" /></symbol>
      <symbol id="i-shield" viewBox="0 0 48 48"><path d="M24 6 L39 12 V23 c0 9 -6 16 -15 19 C15 39 9 32 9 23 V12z" /><path d="M17 24 l5 5 l9 -10" /></symbol>
      <symbol id="i-phone" viewBox="0 0 48 48"><rect x="14" y="5" width="20" height="38" rx="4" /><path d="M21 37 h6" /></symbol>
      <symbol id="i-users" viewBox="0 0 48 48"><circle cx="18" cy="17" r="6" /><circle cx="32" cy="19" r="5" /><path d="M7 39 c1-8 6-12 11-12 s10 4 11 12" /><path d="M29 30 c5-2 11 1 12 9" /></symbol>
      <symbol id="i-camera" viewBox="0 0 48 48"><path d="M6 16 h9 l3 -5 h12 l3 5 h9 v22 H6z" /><circle cx="24" cy="26" r="7" /></symbol>
      <symbol id="i-star" viewBox="0 0 48 48"><path d="M24 6 l5.5 11.5 l12.5 1.8 l-9 8.8 l2.2 12.4 L24 34.6 L12.8 40.5 L15 28.1 l-9-8.8 l12.5-1.8z" /></symbol>
      <symbol id="i-search" viewBox="0 0 48 48"><circle cx="21" cy="21" r="12" /><path d="M30 30 L41 41" /></symbol>
      <symbol id="i-brush" viewBox="0 0 48 48"><path d="M30 6 L42 18 L24 36 L12 24z" /><path d="M12 24 L6 42 L24 36" /></symbol>
    </svg>

    <!-- HLAVIČKA -->
    <header class="top">
      <a href="#top" class="brand" aria-label="Bellarmin – úvod">
        <span class="seal" aria-hidden="true"><svg><use href="#i-paw" /></svg></span>
        <span class="brand-text"><strong>Bellarmin</strong><small>chovatelská stanice</small></span>
      </a>
      <nav class="nav" aria-label="Hlavní navigace">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a href="#kontakt" class="btn btn-orange btn-sm top-cta">Kontakt</a>
      <button class="burger" aria-label="Otevřít menu" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button>
    </header>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobilní navigace">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="#kontakt" class="btn btn-orange">Kontakt</a>
    </nav>

    <main id="top">
      <!-- HERO -->
      <section class="hero">
        <div class="hero-text">
          <p class="kicker"><span></span>Chov · Handling · Hlídání</p>
          <h1><span class="ln"><span>Přátelský</span></span><span class="ln"><span class="accent">charakter.</span></span></h1>
          <p class="lead">Bellarmin je chovatelská stanice, kde se zdraví, povaha a krása berou stejně vážně. Vychováváme štěňata pro život, vodíme psy k úspěchům na výstavách a staráme se o ně, když vy nemůžete.</p>
          <div class="actions">
            <a href="#chov" class="btn btn-orange">Plánované vrhy</a>
            <a href="#sluzby" class="btn btn-ghost">Co nabízíme</a>
          </div>
        </div>
        <figure class="hero-photo">
          <img src={`${img}/hero-setr.webp`} alt="Chovatelka se setrem u vody na podzim" width="828" height="536" fetchpriority="high" />
        </figure>
        <span class="hero-stripe" aria-hidden="true"></span>
        <div class="hero-badge" aria-hidden="true">
          <svg viewBox="0 0 200 200"><defs><path id="rc" d="M100,100 m-70,0 a70,70 0 1,1 140,0 a70,70 0 1,1 -140,0" /></defs>
            <text><textPath href="#rc" textLength="436" lengthAdjust="spacingAndGlyphs">OD ŠTĚNĚTE PO ŠAMPIONA · BELLARMIN · </textPath></text></svg>
          <span class="hb-core"><svg><use href="#i-rosette" /></svg></span>
        </div>
      </section>

      <!-- TŘI SLUŽBY -->
      <section class="services" id="sluzby" aria-labelledby="services-title">
        <div class="wrap">
          <header class="services-head" data-reveal>
            <h2 id="services-title">Tři služby, jeden přístup</h2>
            <p>Chováme, předvádíme i hlídáme se stejnou péčí – zdraví a pohoda psa jsou vždy na prvním místě.</p>
          </header>
          <ul class="tiles" data-reveal="stagger">
            <li><a href="#chov"><span class="rosette"><svg><use href="#i-paw" /></svg></span><span class="t-name">Chov</span><span class="t-arrow" aria-hidden="true">→</span></a></li>
            <li><a href="#handling"><span class="rosette"><svg><use href="#i-rosette" /></svg></span><span class="t-name">Handling</span><span class="t-arrow" aria-hidden="true">→</span></a></li>
            <li><a href="#hlidani"><span class="rosette"><svg><use href="#i-home" /></svg></span><span class="t-name">Hlídání</span><span class="t-arrow" aria-hidden="true">→</span></a></li>
          </ul>
        </div>
      </section>

      <!-- CHOV -->
      <section class="feature chov" id="chov" aria-labelledby="chov-title">
        <figure class="feature-photo" data-reveal="photo">
          <img src={`${img}/chov-svycarsky-pes.webp`} alt="Velký švýcarský salašnický pes s chovatelkou v zimní krajině" width="824" height="984" loading="lazy" />
        </figure>
        <div class="feature-body" data-reveal="stagger">
          <p class="tag"><span class="rosette rosette-sm"><svg><use href="#i-paw" /></svg></span>Chov</p>
          <h2 id="chov-title">Chováme méně.<br /><span class="accent">Zato pořádně.</span></h2>
          <p class="body">Každé spojení plánujeme s ohledem na zdraví, povahu a exteriér. Štěňata vyrůstají v rodině, poznávají běžný svět od prvních týdnů a k novým majitelům odcházejí sebevědomá a socializovaná.</p>
          <ul class="perks">
            <li><svg><use href="#i-shield" /></svg><span><strong>Zdravotně testovaní rodiče</strong>s doloženými výsledky</span></li>
            <li><svg><use href="#i-heart" /></svg><span><strong>Socializace od narození</strong>zvuky, lidé, cestování</span></li>
            <li><svg><use href="#i-phone" /></svg><span><strong>Podpora i po odběru</strong>jsme na telefonu celý psí život</span></li>
          </ul>
          <div class="actions">
            <a href="#kontakt" class="btn btn-dark">Zájem o štěně</a>
            <a href="#kontakt" class="link">Naši psi a fenky →</a>
          </div>
        </div>
      </section>

      <!-- HANDLING -->
      <section class="feature handling" id="handling" aria-labelledby="handling-title">
        <div class="feature-body" data-reveal="stagger">
          <p class="tag tag-light"><span class="rosette rosette-sm rosette-light"><svg><use href="#i-rosette" /></svg></span>Handling</p>
          <h2 id="handling-title">V kruhu rozhoduje<br /><span class="accent">každá vteřina.</span></h2>
          <p class="body">Výstava není jen o krásném psovi. Je o přípravě, kondici, úpravě srsti a klidné ruce, která psa ukáže v nejlepším světle. To vše za vás převezmeme – od tréninku až po kruh.</p>
          <ol class="chevrons">
            <li><svg><use href="#i-search" /></svg>Konzultace</li>
            <li><svg><use href="#i-brush" /></svg>Příprava</li>
            <li><svg><use href="#i-star" /></svg>Výstava</li>
          </ol>
          <div class="actions">
            <a href="#kontakt" class="btn btn-orange">Domluvit handling</a>
            <a href="#kontakt" class="link link-light">Výstavní kalendář →</a>
          </div>
        </div>
        <figure class="feature-photo" data-reveal="photo">
          <img src={`${img}/handling-vystava.webp`} alt="Handlerka se setrem a výstavní rozetou před zámkem" width="828" height="1444" loading="lazy" />
        </figure>
      </section>

      <!-- HLÍDÁNÍ -->
      <section class="hlidani" id="hlidani" aria-labelledby="hlidani-title">
        <div class="wrap">
          <div class="hl-head" data-reveal="stagger">
            <div>
              <p class="tag"><span class="rosette rosette-sm"><svg><use href="#i-home" /></svg></span>Hlídání psů</p>
              <h2 id="hlidani-title">Odjeďte v klidu.<br /><span class="accent">Tady je jako doma.</span></h2>
            </div>
            <p class="body">Hlídáme jen tolik psů, kolik zvládneme opravdu dobře. Mají své pelíšky, společnost a denní program – procházky, hru i odpočinek. A vy dostanete fotku, že je všechno v pořádku.</p>
          </div>
          <figure class="hl-photo" data-reveal="photo">
            <img src={`${img}/hlidani-pelisky.webp`} alt="Psi odpočívají na pelíšcích v místnosti s výstavními trofejemi" width="828" height="563" loading="lazy" />
          </figure>
          <ul class="cards" data-reveal="stagger">
            <li><span class="rosette"><svg><use href="#i-home" /></svg></span><h3>Rodinné prostředí</h3><p>Žádné kotce ani boxy. Psi bydlí s námi v domě.</p></li>
            <li><span class="rosette"><svg><use href="#i-users" /></svg></span><h3>Malá skupina</h3><p>Omezený počet psů, aby se každému dostalo pozornosti.</p></li>
            <li><span class="rosette"><svg><use href="#i-camera" /></svg></span><h3>Zprávy každý den</h3><p>Fotky a krátká zpráva, jak se váš pes má.</p></li>
            <li><span class="rosette"><svg><use href="#i-heart" /></svg></span><h3>Zkušené ruce</h3><p>Rozumíme povahám i potřebám různých plemen.</p></li>
          </ul>
          <div class="center" data-reveal><a href="#kontakt" class="btn btn-dark">Ověřit volný termín</a></div>
        </div>
      </section>

      <!-- PŘÍSTUP -->
      <section class="manifest" id="pristup" aria-labelledby="manifest-title">
        <div class="wrap manifest-grid">
          <span class="quote-mark" aria-hidden="true">„</span>
          <div data-reveal="stagger">
            <p class="tag tag-dark">Náš přístup</p>
            <h2 id="manifest-title">Pes není výstavní exponát ani projekt. Je to parťák, který si zaslouží to nejlepší – doma, v kruhu i na cestách.</h2>
            <ul class="values">
              <li><svg><use href="#i-shield" /></svg><span><strong>Zdraví</strong>na prvním místě</span></li>
              <li><svg><use href="#i-heart" /></svg><span><strong>Povaha</strong>stejně důležitá jako vzhled</span></li>
              <li><svg><use href="#i-paw" /></svg><span><strong>Respekt</strong>ke psům i jejich lidem</span></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- KONTAKT -->
      <section class="contact" id="kontakt" aria-labelledby="contact-title">
        <div class="wrap contact-grid">
          <div data-reveal="stagger">
            <p class="tag"><span class="rosette rosette-sm"><svg><use href="#i-phone" /></svg></span>Kontakt</p>
            <h2 id="contact-title">Napište nám.<br /><span class="accent">Ozveme se do 24 hodin.</span></h2>
            <p class="body">Zajímá vás štěně, handling, nebo hledáte hlídání na dovolenou? Napište pár řádků o sobě a svém psovi.</p>
            <ul class="contact-list">
              <li><span>Telefon</span><a href="tel:+420000000000">+420 000 000 000</a></li>
              <li><span>E-mail</span><a href="mailto:info@bellarmin.cz">info@bellarmin.cz</a></li>
              <li><span>Lokalita</span>Doplnit obec, Česká republika</li>
            </ul>
          </div>
          <form class="form" data-reveal="card" onsubmit="event.preventDefault(); this.querySelector('.form-ok').hidden = false;">
            <fieldset class="topics">
              <legend>Mám zájem o</legend>
              <label><input type="radio" name="topic" value="chov" checked /><span>Štěně</span></label>
              <label><input type="radio" name="topic" value="handling" /><span>Handling</span></label>
              <label><input type="radio" name="topic" value="hlidani" /><span>Hlídání</span></label>
            </fieldset>
            <label class="field"><span>Jméno</span><input type="text" name="name" autocomplete="name" required /></label>
            <label class="field"><span>E-mail nebo telefon</span><input type="text" name="contact" required /></label>
            <label class="field"><span>Zpráva</span><textarea name="message" rows="3" placeholder="Plemeno, věk psa, termín…"></textarea></label>
            <button type="submit" class="btn btn-orange btn-block">Odeslat zprávu</button>
            <p class="form-ok" hidden>Děkujeme, zpráva je na cestě. (ukázka – formulář zatím nic neodesílá)</p>
          </form>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <a href="#top" class="brand">
          <span class="seal" aria-hidden="true"><svg><use href="#i-paw" /></svg></span>
          <span class="brand-text"><strong>Bellarmin</strong><small>chovatelská stanice</small></span>
        </a>
        <nav aria-label="Patička">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href="#kontakt">Kontakt</a>
        </nav>
        <p>© {new Date().getFullYear()} Bellarmin. Chovatelská stanice registrovaná pod ČMKU / FCI.</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        window.__b8Ready = true;
        const root = document.documentElement;
        const burger = document.querySelector('.burger');
        const setMenu = (open) => { burger.setAttribute('aria-expanded', String(open)); root.classList.toggle('menu-open', open); };
        burger.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));
        document.querySelectorAll('.mobile-nav a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

        const header = document.querySelector('.top');
        const els = [...document.querySelectorAll('[data-reveal]')];
        document.querySelectorAll('[data-reveal="stagger"]').forEach((el) => [...el.children].forEach((c, i) => c.style.setProperty('--i', i)));
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) els.forEach((el) => el.classList.add('in'));
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { threshold: 0.12 });
        els.forEach((el) => io.observe(el));
        const onScroll = () => {
          header.classList.toggle('scrolled', scrollY > 30);
          els.forEach((el) => { if (!el.classList.contains('in') && el.getBoundingClientRect().top < innerHeight * 0.9) el.classList.add('in'); });
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>

    <style is:global>
      :root {
        --espresso: #3d291b;
        --brown: #593a24;
        --caramel: #bf874f;
        --orange: #df7b29;
        --orange-dark: #c4661a;
        --forest: #2e4536;
        --taupe: #8b8178;
        --cream: #faf4e9;
        --white: #ffffff;
        --display: 'Oswald', 'Arial Narrow', sans-serif;
        --body: 'Manrope', system-ui, sans-serif;
        --gutter: clamp(16px, 4vw, 56px);
        --head-h: 76px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --cut: clamp(40px, 7vw, 110px);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 80px; }
      body { margin: 0; background: var(--cream); color: var(--espresso); font-family: var(--body); font-size: 17px; line-height: 1.65; -webkit-font-smoothing: antialiased; overflow-x: clip; }
      img { display: block; max-width: 100%; }
      a { color: inherit; }
      p, figure { margin: 0; }
      h1, h2, h3 { font-family: var(--display); font-weight: 600; text-transform: uppercase; line-height: 1.02; margin: 0; letter-spacing: 0.005em; }
      h2 { font-size: clamp(2.1rem, 4.4vw, 3.5rem); }
      .accent { color: var(--orange); }
      .wrap { max-width: 1240px; margin: 0 auto; padding: 0 var(--gutter); }
      .center { text-align: center; }
      svg { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

      /* Rozeta – kruhový odznak s ikonou (místo číslic) */
      .rosette {
        position: relative; display: inline-grid; place-items: center; width: 64px; height: 64px; flex: none;
        border-radius: 50%; background: var(--white); color: var(--orange);
        box-shadow: 0 0 0 2px var(--orange), 0 0 0 6px var(--white), 0 0 0 7px rgba(191, 135, 79, 0.45);
      }
      .rosette svg { width: 30px; height: 30px; }
      .rosette-sm { width: 40px; height: 40px; box-shadow: 0 0 0 2px var(--orange), 0 0 0 5px var(--cream), 0 0 0 6px rgba(191, 135, 79, 0.45); }
      .rosette-sm svg { width: 20px; height: 20px; }
      .rosette-light { background: var(--forest); color: var(--orange); box-shadow: 0 0 0 2px var(--orange), 0 0 0 5px var(--forest), 0 0 0 6px rgba(250, 244, 233, 0.3); }
      .tag {
        display: flex; align-items: center; gap: 0.9rem; margin-bottom: 1.3rem;
        font-family: var(--body); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--caramel);
      }
      .tag-light { color: var(--caramel); }
      .tag-dark { color: var(--espresso); }

      /* Tlačítka */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem 1.8rem;
        font: 500 0.95rem var(--display); letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none;
        border: 2px solid transparent; cursor: pointer; position: relative; overflow: hidden; isolation: isolate;
        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%);
        transition: color 0.3s, border-color 0.3s;
      }
      .btn::before { content: ''; position: absolute; inset: 0; z-index: -1; transform: translateX(-101%); transition: transform 0.45s var(--ease); }
      .btn:hover::before { transform: none; }
      .btn-sm { padding: 0.65rem 1.25rem; font-size: 0.85rem; }
      .btn-orange { background: var(--orange); color: var(--white); }
      .btn-orange::before { background: var(--orange-dark); }
      .btn-dark { background: var(--espresso); color: var(--cream); }
      .btn-dark::before { background: var(--brown); }
      .btn-ghost { border-color: rgba(250, 244, 233, 0.45); color: var(--cream); clip-path: none; }
      .btn-ghost::before { background: var(--cream); }
      .btn-ghost:hover { color: var(--espresso); border-color: var(--cream); }
      .btn-block { width: 100%; }
      .link { font: 500 0.9rem var(--display); letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; color: var(--brown); padding-bottom: 3px;
        background: linear-gradient(var(--orange), var(--orange)) 0 100% / 100% 2px no-repeat; transition: background-size 0.4s var(--ease); }
      .link:hover { background-size: 35% 2px; }
      .link-light { color: var(--cream); }
      .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }

      /* Hlavička */
      .top {
        position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--head-h);
        display: flex; align-items: center; gap: 2rem; padding: 0 var(--gutter);
        background: var(--espresso); color: var(--cream); transition: box-shadow 0.3s;
      }
      .top.scrolled { box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25); }
      .brand { display: flex; align-items: center; gap: 0.8rem; text-decoration: none; margin-right: auto; }
      .seal { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; color: var(--orange); box-shadow: inset 0 0 0 2px var(--orange); }
      .seal svg { width: 22px; height: 22px; fill: var(--orange); stroke: none; }
      .brand-text { display: flex; flex-direction: column; line-height: 1.05; }
      .brand-text strong { font: 600 1.35rem var(--display); letter-spacing: 0.16em; text-transform: uppercase; }
      .brand-text small { font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.7; }
      .nav { display: flex; gap: 2.2rem; }
      .nav a { font: 500 0.92rem var(--display); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; position: relative; padding: 0.4rem 0; }
      .nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--orange); transform: scaleX(0); transform-origin: right; transition: transform 0.35s var(--ease); }
      .nav a:hover::after { transform: scaleX(1); transform-origin: left; }
      .burger { display: none; background: none; border: 0; padding: 10px; cursor: pointer; }
      .burger span { display: block; width: 26px; height: 2px; background: var(--cream); margin: 6px 0; transition: transform 0.3s var(--ease); }
      .menu-open .burger span:first-child { transform: translateY(4px) rotate(45deg); }
      .menu-open .burger span:last-child { transform: translateY(-4px) rotate(-45deg); }
      .mobile-nav { position: fixed; inset: var(--head-h) 0 0 0; z-index: 40; background: var(--espresso); color: var(--cream);
        display: flex; flex-direction: column; justify-content: center; gap: 1.4rem; padding: 0 var(--gutter);
        clip-path: inset(0 0 100% 0); transition: clip-path 0.5s var(--ease); }
      .mobile-nav a:not(.btn) { font: 500 2rem var(--display); letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; }
      .menu-open .mobile-nav { clip-path: inset(0 0 0 0); }

      /* Hero – šikmý řez s oranžovým pruhem */
      .hero { position: relative; margin-top: var(--head-h); display: grid; grid-template-columns: minmax(0, 44fr) minmax(0, 56fr); min-height: min(calc(100vh - var(--head-h)), 820px); background: var(--espresso); color: var(--cream); overflow: hidden; }
      .hero-text { position: relative; z-index: 3; display: flex; flex-direction: column; justify-content: center; padding: 4rem 2rem 5rem var(--gutter); }
      .kicker { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1.4rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--caramel); }
      .kicker span { width: 34px; height: 2px; background: var(--orange); }
      .hero h1 { font-size: clamp(3.2rem, 6.6vw, 6.4rem); margin-bottom: 1.8rem; line-height: 0.98; }
      .hero h1 .ln { display: block; overflow: hidden; }
      .hero h1 .ln > span { display: block; animation: lnUp 1.1s var(--ease) both; }
      .hero h1 .ln + .ln > span { animation-delay: 0.12s; }
      @keyframes lnUp { from { transform: translateY(105%); } to { transform: none; } }
      .lead { max-width: 30rem; color: rgba(250, 244, 233, 0.8); margin-bottom: 2.4rem; animation: fadeUp 1s 0.35s var(--ease) both; }
      .hero .actions { animation: fadeUp 1s 0.5s var(--ease) both; }
      .kicker { animation: fadeUp 0.9s var(--ease) both; }
      @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
      .hero-photo { position: relative; z-index: 1; margin-left: calc(var(--cut) * -1.2); clip-path: polygon(var(--cut) 0, 100% 0, 100% 100%, 0 100%); animation: photoIn 1.4s 0.15s var(--ease) both; }
      @keyframes photoIn { from { clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%); } to { clip-path: polygon(var(--cut) 0, 100% 0, 100% 100%, 0 100%); } }
      .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 66% 50%; animation: zoomOut 2.2s var(--ease) both; }
      @keyframes zoomOut { from { scale: 1.15; } to { scale: 1; } }
      .hero-stripe { position: absolute; z-index: 2; top: 0; bottom: 0; left: calc(44% - var(--cut) * 1.2 - 2px); width: calc(var(--cut) + 14px);
        background: var(--orange); clip-path: polygon(calc(100% - 14px) 0, 100% 0, 14px 100%, 0 100%); animation: stripeIn 1s 0.6s var(--ease) both; }
      @keyframes stripeIn { from { clip-path: polygon(calc(100% - 14px) 0, 100% 0, 100% 0, calc(100% - 14px) 0); } }
      .hero-badge { position: absolute; z-index: 3; right: clamp(16px, 3vw, 40px); bottom: clamp(16px, 3vw, 40px); width: 136px; height: 136px; display: grid; place-items: center; animation: fadeUp 1s 0.9s var(--ease) both; }
      .hero-badge > svg { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 30s linear infinite; }
      .hero-badge text { fill: var(--cream); stroke: none; font: 600 15px var(--body); letter-spacing: 0.1em; }
      .hero-badge::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: rgba(61, 41, 27, 0.72); backdrop-filter: blur(6px); }
      .hb-core { position: relative; width: 62px; height: 62px; border-radius: 50%; background: var(--orange); color: var(--white); display: grid; place-items: center; }
      .hb-core svg { width: 32px; height: 32px; }
      @keyframes spin { to { transform: rotate(360deg); } }

      /* Tři služby – dlaždice s rozetami */
      .services { padding: clamp(2.8rem, 5vw, 4rem) 0; background: var(--cream); }
      .services-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.6rem 2.5rem; margin-bottom: 2rem; }
      .services-head h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); }
      .services-head p { color: var(--brown); max-width: 34rem; font-size: 0.97rem; }
      .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
      .tiles a {
        display: flex; align-items: center; gap: 1.4rem; padding: 1.4rem 1.6rem; background: var(--white); text-decoration: none; position: relative;
        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%);
        transition: background 0.35s, color 0.35s;
      }
      .tiles a::after { content: ''; position: absolute; left: 0; bottom: 0; height: 4px; width: 100%; background: var(--orange); transform: scaleX(0.18); transform-origin: left; transition: transform 0.5s var(--ease); }
      .tiles a:hover { background: var(--espresso); color: var(--cream); }
      .tiles a:hover::after { transform: scaleX(1); }
      .tiles a:hover .rosette { box-shadow: 0 0 0 2px var(--orange), 0 0 0 6px var(--espresso), 0 0 0 7px rgba(191, 135, 79, 0.6); transform: rotate(-12deg); }
      .tiles .rosette { transition: transform 0.5s var(--ease), box-shadow 0.35s; }
      .t-name { font: 600 clamp(1.5rem, 2.3vw, 2rem) var(--display); text-transform: uppercase; }
      .t-arrow { margin-left: auto; font-size: 1.6rem; color: var(--orange); transition: transform 0.4s var(--ease); }
      .tiles a:hover .t-arrow { transform: translateX(6px); }

      /* Bloky služeb – fotka se šikmým řezem přes celou výšku */
      .feature { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 640px; position: relative; overflow: hidden; }
      .feature-photo { position: relative; min-height: 520px; }
      .feature-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .feature-body { display: flex; flex-direction: column; justify-content: center; padding: clamp(3.5rem, 7vw, 6rem) var(--gutter); max-width: 680px; }
      .feature-body h2 { margin-bottom: 1.4rem; }
      .body { color: var(--brown); max-width: 34rem; margin-bottom: 2rem; }
      .chov { background: var(--white); }
      .chov .feature-photo { clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut)) 100%, 0 100%); }
      .chov .feature-photo::after { content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: calc(var(--cut) + 12px); background: var(--orange); clip-path: polygon(calc(100% - 12px) 0, 100% 0, 12px 100%, 0 100%); }
      .chov .feature-photo img { object-position: 50% 40%; }
      .perks { list-style: none; padding: 0; margin: 0 0 2.2rem; display: grid; gap: 1rem; }
      .perks li { display: flex; gap: 1rem; align-items: flex-start; }
      .perks svg { width: 26px; height: 26px; flex: none; color: var(--orange); margin-top: 2px; }
      .perks strong { display: block; font-weight: 700; }
      .perks span { color: var(--brown); }
      .handling { background: var(--forest); color: var(--cream); }
      .handling .feature-body { justify-self: end; }
      .handling .body { color: rgba(250, 244, 233, 0.78); }
      .handling .feature-photo { clip-path: polygon(var(--cut) 0, 100% 0, 100% 100%, 0 100%); }
      .handling .feature-photo::after { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: calc(var(--cut) + 12px); background: var(--orange); clip-path: polygon(calc(100% - 12px) 0, 100% 0, 12px 100%, 0 100%); }
      .handling .feature-photo img { object-position: 50% 55%; }
      .chevrons { list-style: none; padding: 0; margin: 0 0 2.4rem; display: flex; flex-wrap: wrap; }
      .chevrons li {
        display: flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1.6rem 0.85rem 2rem; margin-right: -10px;
        font: 500 1rem var(--display); letter-spacing: 0.08em; text-transform: uppercase;
        background: rgba(250, 244, 233, 0.08); clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%, 16px 50%);
      }
      .chevrons li:first-child { padding-left: 1.4rem; clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%); }
      .chevrons li:last-child { background: var(--orange); color: var(--white); }
      .chevrons svg { width: 20px; height: 20px; color: var(--orange); }
      .chevrons li:last-child svg { color: var(--white); }

      /* Hlídání */
      .hlidani { padding: clamp(4.5rem, 9vw, 7.5rem) 0; }
      .hl-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: end; margin-bottom: 2.6rem; }
      .hl-head .body { margin-bottom: 0; }
      .hl-photo { aspect-ratio: 21 / 9; overflow: hidden; clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut) * 0.6), calc(100% - var(--cut) * 0.6) 100%, 0 100%); }
      .hl-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }
      .cards { list-style: none; padding: 0; margin: -3.5rem 0 3rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.2rem; position: relative; z-index: 2; padding: 0 clamp(0px, 2vw, 24px); }
      .cards li { background: var(--white); padding: 2.6rem 1.4rem 1.6rem; position: relative; border-bottom: 4px solid var(--orange); box-shadow: 0 20px 40px -24px rgba(61, 41, 27, 0.35); transition: transform 0.45s var(--ease); }
      .cards li:hover { transform: translateY(-6px); }
      .cards .rosette { position: absolute; top: -30px; left: 1.4rem; width: 56px; height: 56px; }
      .cards .rosette svg { width: 26px; height: 26px; }
      .cards h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
      .cards p { color: var(--taupe); font-size: 0.95rem; }

      /* Přístup – oranžový pás */
      .manifest { background: var(--orange); color: var(--espresso); padding: clamp(4.5rem, 9vw, 7rem) 0; position: relative; overflow: hidden;
        clip-path: polygon(0 var(--cut), 100% 0, 100% calc(100% - var(--cut)), 0 100%); margin: calc(var(--cut) * -0.5) 0; }
      .manifest-grid { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(1rem, 3vw, 3rem); align-items: start; padding-top: var(--cut); padding-bottom: var(--cut); }
      .quote-mark { font: 700 clamp(8rem, 16vw, 14rem) / 0.7 var(--display); color: var(--espresso); opacity: 0.9; }
      .manifest h2 { font-size: clamp(1.8rem, 3.6vw, 3rem); line-height: 1.12; margin-bottom: 2.6rem; }
      .values { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
      .values li { display: flex; gap: 0.9rem; align-items: flex-start; border-top: 2px solid var(--espresso); padding-top: 1rem; }
      .values svg { width: 28px; height: 28px; flex: none; }
      .values strong { display: block; font: 600 1.4rem var(--display); text-transform: uppercase; line-height: 1.1; }

      /* Kontakt – tmavý formulář */
      .contact { padding: calc(clamp(4.5rem, 9vw, 7rem) + var(--cut) * 0.5) 0 clamp(4.5rem, 9vw, 7rem); }
      .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
      .contact h2 { margin-bottom: 1.4rem; }
      .contact-list { list-style: none; padding: 0; margin: 0; }
      .contact-list li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); padding: 0.9rem 0; border-bottom: 1px solid rgba(61, 41, 27, 0.15); }
      .contact-list span { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--taupe); padding-top: 0.2rem; }
      .contact-list a { text-decoration: none; font-weight: 600; } .contact-list a:hover { color: var(--orange); }
      .form { background: var(--espresso); color: var(--cream); padding: clamp(1.6rem, 4vw, 2.8rem); display: grid; gap: 1.2rem;
        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 36px), calc(100% - 36px) 100%, 0 100%); }
      .topics { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
      .topics legend, .field span { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--caramel); margin-bottom: 0.6rem; }
      .topics input { position: absolute; opacity: 0; }
      .topics span { display: inline-block; padding: 0.55rem 1.1rem; border: 1.5px solid rgba(250, 244, 233, 0.3); font: 500 0.88rem var(--display); letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: background 0.25s, border-color 0.25s; }
      .topics input:checked + span { background: var(--orange); border-color: var(--orange); color: var(--white); }
      .topics input:focus-visible + span { outline: 2px solid var(--orange); outline-offset: 2px; }
      .field { display: grid; }
      .field span { margin-bottom: 0.4rem; }
      .field input, .field textarea { font: inherit; color: var(--cream); background: rgba(250, 244, 233, 0.07); border: 0; border-bottom: 2px solid rgba(250, 244, 233, 0.25); padding: 0.8rem 0.9rem; border-radius: 0; resize: vertical; }
      .field input:focus, .field textarea:focus { outline: none; border-bottom-color: var(--orange); }
      .field textarea::placeholder { color: rgba(250, 244, 233, 0.45); }
      .form-ok { color: var(--caramel); font-weight: 600; }

      /* Patička */
      .foot { background: var(--espresso); color: rgba(250, 244, 233, 0.7); padding: 3rem 0; font-size: 0.9rem; border-top: 4px solid var(--orange); }
      .foot-grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; }
      .foot .brand { margin-right: 0; color: var(--cream); }
      .foot nav { display: flex; flex-wrap: wrap; gap: 1.6rem; }
      .foot nav a { text-decoration: none; font-family: var(--display); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.85rem; }
      .foot nav a:hover { color: var(--orange); }
      .foot p { width: 100%; padding-top: 1.5rem; border-top: 1px solid rgba(250, 244, 233, 0.12); font-size: 0.8rem; }

      /* Odhalování při scrollu */
      .js [data-reveal]:not([data-reveal="photo"]):not([data-reveal="stagger"]) { opacity: 0; transform: translateY(30px); transition: opacity 0.9s var(--ease), transform 1s var(--ease); }
      .js [data-reveal="card"] { transform: translateX(40px); }
      .js [data-reveal].in { opacity: 1 !important; transform: none !important; }
      .js [data-reveal="stagger"] > * { opacity: 0; transform: translateY(26px); transition: opacity 0.8s var(--ease), transform 1s var(--ease); transition-delay: calc(var(--i, 0) * 0.08s); }
      .js [data-reveal="stagger"].in > * { opacity: 1; transform: none; }
      .js [data-reveal="photo"] img { scale: 1.18; opacity: 0.2; transition: scale 1.6s var(--ease), opacity 1s var(--ease); }
      .js [data-reveal="photo"].in img { scale: 1; opacity: 1; }
      .js .chov .feature-photo::after, .js .handling .feature-photo::after { transform: translateY(-101%); transition: transform 1s 0.3s var(--ease); }
      .js .chov .feature-photo.in::after, .js .handling .feature-photo.in::after { transform: none; }

      /* Responsivita */
      @media (max-width: 980px) {
        .nav, .top-cta { display: none; }
        .burger { display: block; margin-left: auto; }
        :root { --head-h: 68px; }
        .hero { grid-template-columns: 1fr; min-height: 0; }
        .hero-photo { order: -1; margin-left: 0; aspect-ratio: 4 / 3; clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), 0 100%); animation-name: photoInM; }
        @keyframes photoInM { from { clip-path: polygon(0 0, 100% 0, 100% 0, 0 0); } to { clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), 0 100%); } }
        .hero-stripe { display: none; }
        .hero-text { padding: 2rem var(--gutter) 3.5rem; }
        .hero-badge { top: calc(75vw - 124px); bottom: auto; width: 104px; height: 104px; }
        .hb-core { width: 48px; height: 48px; } .hb-core svg { width: 24px; height: 24px; }
        .tiles { grid-template-columns: 1fr; gap: 0.8rem; }
        .feature { grid-template-columns: 1fr; min-height: 0; }
        .feature-photo { min-height: 0; aspect-ratio: 4 / 3.4; }
        .handling .feature-photo { order: -1; }
        .chov .feature-photo, .handling .feature-photo { clip-path: polygon(0 0, 100% 0, 100% calc(100% - var(--cut)), 0 100%); }
        .chov .feature-photo::after, .handling .feature-photo::after { display: none; }
        .handling .feature-body { justify-self: stretch; }
        .hl-head, .contact-grid { grid-template-columns: 1fr; }
        .hl-photo { aspect-ratio: 4 / 3; }
        .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.6rem 1rem; }
        .values { grid-template-columns: 1fr; }
      }
      @media (max-width: 560px) {
        body { font-size: 16px; }
        .brand-text strong { font-size: 1.15rem; }
        .cards { grid-template-columns: 1fr; margin-top: -2rem; padding: 0; }
        .manifest-grid { grid-template-columns: 1fr; }
        .quote-mark { font-size: 7rem; margin-bottom: 0.4rem; }
        .contact-list li { grid-template-columns: 1fr; gap: 0.2rem; }
        .chevrons li { padding: 0.75rem 1.2rem 0.75rem 1.6rem; font-size: 0.9rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation: none !important; transition: none !important; }
        .js [data-reveal], .js [data-reveal] > *, .js [data-reveal] img { opacity: 1 !important; transform: none !important; scale: 1 !important; }
      }
    </style>
  </body>
</html>
