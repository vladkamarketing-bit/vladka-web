---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import homepage from '../content/homepage.json';
import FAQ from '../components/FAQ.tsx';
---

<Layout>

  <!-- ═══════════════════════════════════════════
       HERO
  ════════════════════════════════════════════ -->
  <section id="hero" class="relative min-h-screen flex items-center bg-vh-ivory overflow-hidden">

    <!-- Dekorativní kruh vpravo -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-vh-muted opacity-[0.08] pointer-events-none translate-x-1/4"></div>

    <!-- Vodoznakové V -->
    <div class="absolute inset-0 flex items-center justify-end overflow-hidden pointer-events-none select-none">
      <span class="font-serif font-light leading-none text-vh-dark opacity-[0.06]" style="font-size: 100vh;">V</span>
    </div>

    <div class="relative max-w-6xl mx-auto px-6 pt-32 pb-24 w-full">
      <div class="max-w-2xl">

        <!-- Kicker -->
        <div class="flex items-center gap-4 text-vh-bronze mb-8">
          <span class="w-8 h-px bg-vh-bronze"></span>
          <span class="uppercase tracking-widest text-xs font-medium font-sans">Marketingový stratég & Web designérka</span>
        </div>

        <!-- H1 -->
        <h1 class="font-serif leading-[1.1] text-vh-dark mb-8" style="font-size: clamp(3rem, 7vw, 5rem); font-weight: 400;">
          <span style="font-style: normal;">{homepage.heroTitle}</span><br/>
          <span style="font-style: italic; font-size: calc(1em - 4px);">{homepage.heroTitleLine2}</span>
        </h1>

        <!-- Perex -->
        <p class="text-vh-muted text-lg leading-relaxed mb-10 max-w-lg font-sans">
        {homepage.heroSubtitle}
        </p>

        <!-- Tlačítka -->
        <div class="flex flex-wrap items-center gap-6">
          <a
            href="#contact"
            class="px-8 py-4 bg-vh-sage text-white rounded-full text-sm font-medium hover:bg-vh-sage/80 transition-colors font-sans"
          >
            Chci nezávaznou konzultaci
          </a>
          <a
            href="#portfolio"
            class="text-vh-dark text-sm font-medium hover:text-vh-sage transition-colors font-sans group flex items-center gap-1"
          >
            Prohlédnout portfolio
            <span class="inline-block group-hover:translate-x-1 transition-transform">→</span>
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       MŮJ PŘÍSTUP
  ════════════════════════════════════════════ -->
  <section id="approach" class="bg-white/50 py-24">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Header -->
      <div class="text-center mb-14">
        <div class="flex items-center justify-center gap-4 text-vh-bronze mb-5">
          <span class="w-8 h-px bg-vh-bronze"></span>
          <span class="uppercase tracking-widest text-xs font-medium font-sans">{homepage.approachKicker}</span>
          <span class="w-8 h-px bg-vh-bronze"></span>
        </div>
        <h2 class="font-serif font-light text-5xl text-vh-dark mb-5">{homepage.approachTitle}</h2>
        <p class="text-vh-muted font-sans text-sm leading-relaxed max-w-lg mx-auto">
          {homepage.approachText}
        </p>
      </div>

      <!-- 4 karty -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

        {[
          <>
            <rect x="2" y="6" width="32" height="22" rx="2.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M12 32h12M18 28v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M2 22h32" stroke="currentColor" stroke-width="1.5"/>
          </>,
          <path d="M12 6l-8 22 10-6 4 8 4-8 10 6L24 6l-6 9-6-9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>,
          <>
            <circle cx="16" cy="16" r="11" stroke="currentColor" stroke-width="1.5"/>
            <path d="M29 29l-5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M10 19l4-5 3 3 5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </>,
          <>
            <path d="M26 4l6 6-18 18H8v-6L26 4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M22 8l6 6" stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 32h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </>,
        ].map((icon, i) => {
          const card = homepage.approachCards[i];
          return (
            <div class="bg-white rounded-2xl p-7 flex flex-col gap-6 border border-vh-dark/5">
              <div class="text-vh-sage">
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                  {icon}
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="font-serif text-xl text-vh-dark mb-2">{card.title}</h3>
                <p class="text-vh-muted font-sans text-sm leading-relaxed">{card.text}</p>
              </div>
              <div class="h-1.5 w-10 bg-vh-ivory rounded-full"></div>
            </div>
          );
        })}

      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       SLUŽBY
  ════════════════════════════════════════════ -->
  <section id="services" class="bg-vh-ivory py-24">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-14">
        <div>
          <div class="flex items-center gap-4 text-vh-bronze mb-5">
            <span class="w-8 h-px bg-vh-bronze"></span>
            <span class="uppercase tracking-widest text-xs font-medium font-sans">{homepage.servicesKicker}</span>
          </div>
          <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight">{homepage.servicesTitle}</h2>
        </div>
        <p class="text-vh-muted leading-relaxed max-w-sm font-sans text-sm md:text-right">
          {homepage.servicesText}
        </p>
      </div>

      <!-- Hlavní karta — zelená -->
      <div class="bg-vh-sage rounded-2xl p-8 md:p-12 mb-5 grid md:grid-cols-2 gap-10">
        <!-- Vlevo -->
        <div class="flex flex-col justify-between">
          <div>
            <p class="text-vh-sage-light text-xs uppercase tracking-widest font-sans mb-4">{homepage.servicesMainLabel}</p>
            <h3 class="font-serif font-light text-4xl text-white leading-tight mb-4">{homepage.servicesMainTitle}</h3>
            <p class="text-white/60 font-sans text-sm leading-relaxed mb-8">
              {homepage.servicesMainText}
            </p>
            <p class="font-serif italic text-2xl text-white/80 mb-10">{homepage.servicesMainPrice}</p>
          </div>
          <a
            href="#contact"
            class="inline-block self-start px-7 py-3.5 bg-white text-vh-sage rounded-full text-sm font-medium hover:bg-vh-ivory transition-colors font-sans"
          >
            {homepage.servicesMainButton}
          </a>
        </div>
        <!-- Vpravo — checklist -->
        <ul class="space-y-3 self-center">
          {homepage.servicesChecklist.map(item => (
            <li class="flex items-start gap-3 text-white/80 font-sans text-sm">
              <svg class="w-5 h-5 text-vh-sage-light flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="9" stroke="currentColor" strokeWidth="1.2"/>
                <path d="M6.5 10.5l2.5 2.5 4.5-5" stroke="currentColor" strokeWidth="1.4" strokeLinecap="round" strokeLinejoin="round"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- 2 barevné karty -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
        {homepage.servicesCards2.map((card, i) => {
          // Hnědá a zelená se střídají: na mobilu (1 sloupec) jedna po druhé,
          // od 2 sloupců jako šachovnice, aby hnědé boxy byly úhlopříčně.
          const mobileBronze = i % 2 === 0;
          const gridBronze = (Math.floor(i / 2) + i) % 2 === 0;
          const bg = [
            mobileBronze ? "bg-vh-bronze" : "bg-vh-sage/80",
            gridBronze ? "sm:bg-vh-bronze" : "sm:bg-vh-sage/80",
          ].join(" ");
          return (
          <div class={`${bg} rounded-2xl p-8`}>
            <p class="text-white/60 text-xs uppercase tracking-widest font-sans mb-3">{card.label}</p>
            <h3 class="font-serif font-light text-3xl text-white mb-2">{card.title}</h3>
            <p class="font-serif italic text-white/70 text-xl mb-4">{card.price}</p>
            <p class="text-white/60 font-sans text-sm leading-relaxed">
              {card.text}
            </p>
            {card.link && (
              <a href={card.link} class="group inline-flex items-center gap-1.5 mt-5 text-white/80 hover:text-white text-sm font-sans no-underline border-b border-white/30 hover:border-white pb-0.5 transition-colors">
                {card.linkLabel || 'Více informací'}
                <span class="inline-block group-hover:translate-x-1 transition-transform">→</span>
              </a>
            )}
          </div>
          );
        })}
      </div>

      <!-- 3 bílé karty -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {homepage.servicesCards3.map(card => (
          <div class="bg-white rounded-2xl p-8 border border-vh-dark/5">
            <h3 class="font-serif font-light text-2xl text-vh-dark mb-2">{card.name}</h3>
            <p class="font-serif italic text-vh-bronze text-lg mb-4">{card.price}</p>
            <p class="text-vh-muted font-sans text-sm leading-relaxed">{card.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       O MNĚ
  ════════════════════════════════════════════ -->
  <section id="about" class="bg-white/50 py-24">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">

      <!-- Fotka -->
      <div class="aspect-[3/4] w-1/2 mx-auto bg-vh-sage-light/40 rounded-2xl flex items-center justify-center text-vh-muted/40 font-sans text-sm overflow-hidden">
        {homepage.aboutPhoto ? (
          <img src={homepage.aboutPhoto} alt={homepage.aboutName} class="w-full h-full object-cover" />
        ) : (
          <div class="text-center">
            <svg class="w-16 h-16 mx-auto mb-3 opacity-30" viewBox="0 0 64 64" fill="none">
              <rect x="4" y="4" width="56" height="56" rx="4" stroke="currentColor" strokeWidth="1.5"/>
              <circle cx="32" cy="24" r="10" stroke="currentColor" strokeWidth="1.5"/>
              <path d="M8 56c0-13.3 10.7-24 24-24s24 10.7 24 24" stroke="currentColor" strokeWidth="1.5"/>
            </svg>
            Fotografie
          </div>
        )}
      </div>

      <!-- Text -->
      <div>
        <div class="flex items-center gap-4 text-vh-bronze mb-6">
          <span class="w-8 h-px bg-vh-bronze"></span>
          <span class="uppercase tracking-widest text-xs font-medium font-sans">{homepage.aboutKicker}</span>
        </div>
        <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight mb-3">{homepage.aboutName}</h2>
        <p class="font-serif italic text-vh-muted text-xl mb-8">{homepage.aboutSubtitle}</p>

        <div class="space-y-4 text-vh-muted font-sans text-sm leading-relaxed">
          {homepage.aboutParagraphs.map(paragraph => (
            <p>
              {paragraph}
            </p>
          ))}
        </div>
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       PORTFOLIO
  ════════════════════════════════════════════ -->
  <section id="portfolio" class="bg-vh-ivory py-24">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-14">
        <div>
          <div class="flex items-center gap-4 text-vh-bronze mb-5">
            <span class="w-8 h-px bg-vh-bronze"></span>
            <span class="uppercase tracking-widest text-xs font-medium font-sans">{homepage.portfolioKicker}</span>
          </div>
          <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight">{homepage.portfolioTitle}</h2>
        </div>
        <p class="text-vh-muted leading-relaxed max-w-sm font-sans text-sm md:text-right">
          {homepage.portfolioText}
        </p>
      </div>

      <!-- Karty projektů — karusel, viditelné 3, další se posouvají šipkami -->
      <div data-carousel>
      <div data-carousel-track class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar">

        {homepage.portfolioProjects.map((project, i) => {
          const bg = ["bg-vh-sage-light/30", "bg-vh-bronze/10", "bg-vh-dark/5"][i % 3];
          return (
            <div class="shrink-0 snap-start w-full md:w-[calc((100%-3rem)/3)] group bg-white rounded-2xl overflow-hidden border border-vh-dark/5 hover:shadow-lg transition-shadow">
              {project.url ? (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Otevřít web projektu ${project.title} v novém okně`}
                  class={`relative block aspect-video ${bg} overflow-hidden`}
                >
                  <img src={project.image} alt={project.title} class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500" />
                  <span class="absolute bottom-3 right-3 px-3 py-1.5 bg-white/90 text-vh-dark text-xs font-medium font-sans rounded-full shadow-sm opacity-0 group-hover:opacity-100 transition-opacity">
                    Zobrazit web ↗
                  </span>
                </a>
              ) : (
                <div class={`aspect-video ${bg} flex items-center justify-center overflow-hidden`}>
                  {project.image ? (
                    <img src={project.image} alt={project.title} class="w-full h-full object-cover object-top" />
                  ) : (
                    <svg class="w-14 h-14 text-vh-muted/30" viewBox="0 0 56 56" fill="none">
                      <rect x="2" y="2" width="52" height="52" rx="4" stroke="currentColor" strokeWidth="1.5"/>
                      <path d="M2 36l14-12 10 10 8-8 20 16" stroke="currentColor" strokeWidth="1.5" strokeLinejoin="round"/>
                      <circle cx="40" cy="18" r="6" stroke="currentColor" strokeWidth="1.5"/>
                    </svg>
                  )}
                </div>
              )}
              <div class="p-6">
                <div class="flex gap-2 mb-3 flex-wrap">
                  {project.tags.split(",").map(tag => (
                    <span class="text-xs px-2.5 py-1 bg-vh-ivory text-vh-muted rounded-full font-sans">{tag.trim()}</span>
                  ))}
                </div>
                <h3 class="font-serif text-xl text-vh-dark mb-2">{project.title}</h3>
                <p class="text-vh-muted font-sans text-sm leading-relaxed">
                  {project.desc}
                </p>
                {project.url && (
                  <a href={project.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 mt-4 text-sm font-medium font-sans text-vh-sage hover:text-vh-dark transition-colors">
                    Zobrazit web <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          );
        })}

      </div>
      <div data-carousel-nav class="hidden mt-8">
        <div class="flex items-center justify-end gap-3">
        <button type="button" data-carousel-prev aria-label="Předchozí" class="w-11 h-11 rounded-full border border-vh-dark/20 text-vh-dark flex items-center justify-center hover:bg-vh-dark hover:text-white hover:border-vh-dark transition-colors disabled:opacity-30 disabled:pointer-events-none">
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" data-carousel-next aria-label="Další" class="w-11 h-11 rounded-full border border-vh-dark/20 text-vh-dark flex items-center justify-center hover:bg-vh-dark hover:text-white hover:border-vh-dark transition-colors disabled:opacity-30 disabled:pointer-events-none">
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        </div>
      </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       REFERENCE
  ════════════════════════════════════════════ -->
  <section id="testimonials" class="bg-vh-sage py-24">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Header -->
      <div class="text-center mb-14">
        <div class="flex items-center justify-center gap-4 text-vh-sage-light mb-5">
          <span class="w-8 h-px bg-vh-sage-light"></span>
          <span class="uppercase tracking-widest text-xs font-medium font-sans">{homepage.testimonialsKicker}</span>
          <span class="w-8 h-px bg-vh-sage-light"></span>
        </div>
        <h2 class="font-serif font-light text-5xl text-white">{homepage.testimonialsTitle}</h2>
      </div>

      <!-- Karty — karusel, viditelné 3, další se posouvají šipkami -->
      <div data-carousel>
      <div data-carousel-track class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar">

        {homepage.testimonials.map(testimonial => (
          <div class="shrink-0 snap-start w-full md:w-[calc((100%-3rem)/3)] bg-vh-dark/20 rounded-2xl p-8">
            <p class="font-serif text-3xl text-white/30 leading-none mb-4">"</p>
            <p class="text-white/80 font-sans text-sm leading-relaxed mb-8">
              {testimonial.quote}
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-vh-sage-light/30 flex items-center justify-center font-serif text-white font-light">{testimonial.name.trim().charAt(0)}</div>
              <div>
                <p class="text-white font-medium text-sm font-sans">{testimonial.name}</p>
                <p class="text-white/50 text-xs font-sans">{testimonial.role}</p>
              </div>
            </div>
          </div>
        ))}

      </div>
      <div data-carousel-nav class="hidden mt-8">
        <div class="flex items-center justify-center gap-3">
        <button type="button" data-carousel-prev aria-label="Předchozí" class="w-11 h-11 rounded-full border border-white/30 text-white flex items-center justify-center hover:bg-white hover:text-vh-sage hover:border-white transition-colors disabled:opacity-30 disabled:pointer-events-none">
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" data-carousel-next aria-label="Další" class="w-11 h-11 rounded-full border border-white/30 text-white flex items-center justify-center hover:bg-white hover:text-vh-sage hover:border-white transition-colors disabled:opacity-30 disabled:pointer-events-none">
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        </div>
      </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       CTA
  ════════════════════════════════════════════ -->
  <section class="bg-vh-ivory pt-24 pb-12">
    <div class="max-w-xl mx-auto px-6 text-center flex flex-col items-center gap-6">
      <h2 class="font-serif font-light text-4xl text-vh-dark">{homepage.ctaTitle}</h2>
      <p class="font-sans text-vh-muted text-base leading-relaxed">
        {homepage.ctaText}
      </p>
      <a
        href={`mailto:${homepage.contactEmail}`}
        class="w-full px-10 py-5 bg-vh-sage text-white text-base font-medium font-sans rounded-lg hover:bg-vh-sage/85 transition-colors"
      >
        {homepage.ctaButton}
      </a>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       FAQ
  ════════════════════════════════════════════ -->
  <section id="faq" class="bg-vh-ivory pt-12 pb-24">
    <div class="max-w-6xl mx-auto px-6">

      <div class="text-center mb-12">
        <div class="flex items-center justify-center gap-4 text-vh-bronze mb-5">
          <span class="w-8 h-px bg-vh-bronze"></span>
          <span class="uppercase tracking-widest text-xs font-medium font-sans">{homepage.faqKicker}</span>
          <span class="w-8 h-px bg-vh-bronze"></span>
        </div>
        <h2 class="font-serif font-light text-5xl text-vh-dark">{homepage.faqTitle}</h2>
      </div>

      <FAQ client:load faqs={homepage.faqItems} />

    </div>
  </section>


  <!-- ═══════════════════════════════════════════
       KONTAKT
  ════════════════════════════════════════════ -->
  <section id="contact" class="bg-white/50 py-24">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-start">

      <!-- Levá strana -->
      <div>
        <div class="flex items-center gap-4 text-vh-bronze mb-6">
          <span class="w-8 h-px bg-vh-bronze"></span>
          <span class="uppercase tracking-widest text-xs font-medium font-sans">{homepage.contactKicker}</span>
        </div>
        <h2 class="font-serif font-light text-5xl text-vh-dark leading-tight mb-6">
          {homepage.contactTitle}
        </h2>
        <p class="text-vh-muted font-sans text-sm leading-relaxed mb-10">
          {homepage.contactText}
        </p>
        <div class="space-y-4 font-sans text-sm">
          <div class="flex items-center gap-3 text-vh-dark">
            <svg class="w-5 h-5 text-vh-sage flex-shrink-0" viewBox="0 0 20 20" fill="none">
              <path d="M2 6l8 5 8-5M2 6v10a1 1 0 001 1h14a1 1 0 001-1V6a1 1 0 00-1-1H3a1 1 0 00-1 1z" stroke="currentColor" strokeWidth="1.2" strokeLinejoin="round"/>
            </svg>
            <a href={`mailto:${homepage.contactEmail}`} class="hover:text-vh-sage transition-colors">{homepage.contactEmail}</a>
          </div>
        </div>
      </div>

      <!-- Formulář -->
      <form
        id="contact-form"
        action={`https://formsubmit.co/${homepage.contactEmail}`}
        method="POST"
        class="space-y-5"
      >
        <!-- Nastavení FormSubmit -->
        <input type="hidden" name="_subject" value="Nová zpráva z webu" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="block text-xs font-medium text-vh-muted uppercase tracking-wider mb-1.5 font-sans">Jméno</label>
            <input id="contact-name" name="Jméno" type="text" required placeholder="Vaše jméno" class="w-full px-4 py-3 rounded-lg border border-vh-dark/15 bg-white text-vh-dark placeholder:text-vh-muted/50 text-sm font-sans focus:outline-none focus:border-vh-sage transition-colors" />
          </div>
          <div>
            <label for="contact-company" class="block text-xs font-medium text-vh-muted uppercase tracking-wider mb-1.5 font-sans">Firma</label>
            <input id="contact-company" name="Firma" type="text" placeholder="Název firmy" class="w-full px-4 py-3 rounded-lg border border-vh-dark/15 bg-white text-vh-dark placeholder:text-vh-muted/50 text-sm font-sans focus:outline-none focus:border-vh-sage transition-colors" />
          </div>
        </div>
        <div>
          <label for="contact-email" class="block text-xs font-medium text-vh-muted uppercase tracking-wider mb-1.5 font-sans">E-mail</label>
          <input id="contact-email" name="email" type="email" required placeholder="vas@email.cz" class="w-full px-4 py-3 rounded-lg border border-vh-dark/15 bg-white text-vh-dark placeholder:text-vh-muted/50 text-sm font-sans focus:outline-none focus:border-vh-sage transition-colors" />
        </div>
        <div>
          <label for="contact-message" class="block text-xs font-medium text-vh-muted uppercase tracking-wider mb-1.5 font-sans">Zpráva</label>
          <textarea id="contact-message" name="Zpráva" rows="5" required placeholder="Popis projektu, otázky..." class="w-full px-4 py-3 rounded-lg border border-vh-dark/15 bg-white text-vh-dark placeholder:text-vh-muted/50 text-sm font-sans focus:outline-none focus:border-vh-sage transition-colors resize-none"></textarea>
        </div>
        <button
          type="submit"
          class="w-full py-4 bg-vh-sage text-white rounded-full text-sm font-medium hover:bg-vh-sage/80 transition-colors font-sans disabled:opacity-60 disabled:cursor-wait"
        >
          Odeslat zprávu
        </button>
        <p class="text-xs text-vh-muted font-sans text-center leading-relaxed">
          Odesláním formuláře berete na vědomí, že vaše údaje zpracuji za účelem odpovědi na dotaz.
          Více v <a href="/ochrana-osobnich-udaju" class="underline hover:text-vh-sage transition-colors">zásadách ochrany osobních údajů</a>.
        </p>
        <p id="contact-status" class="hidden text-sm font-sans text-center" role="status"></p>
      </form>

    </div>
  </section>

</Layout>

<script>
  // Odeslání formuláře na pozadí, aby návštěvník zůstal na webu.
  // Bez JavaScriptu formulář funguje i klasicky přes atribut action.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled = true;
    status?.classList.add('hidden');

    try {
      const response = await fetch(form.action.replace('formsubmit.co/', 'formsubmit.co/ajax/'), {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      if (status) {
        status.textContent = 'Děkuji, zpráva byla odeslána. Ozvu se vám do 24 hodin v pracovní dny.';
        status.className = 'text-sm font-sans text-center text-vh-sage';
      }
    } catch {
      if (status) {
        status.textContent = 'Zprávu se nepodařilo odeslat. Zkuste to prosím znovu, nebo mi napište přímo na e-mail.';
        status.className = 'text-sm font-sans text-center text-red-700';
      }
    } finally {
      button.disabled = false;
    }
  });
</script>

<script>
  // Karusely (portfolio, reference): šipky posouvají o jednu kartu,
  // na mobilu jde posouvat i prstem. Šipky se ukážou jen tehdy,
  // když se všechny karty nevejdou najednou.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const nav = carousel.querySelector<HTMLElement>('[data-carousel-nav]');
    const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !nav || !prev || !next) return;

    const step = () => {
      const first = track.children[0] as HTMLElement | undefined;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first ? first.offsetWidth + gap : track.clientWidth;
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      nav.classList.toggle('hidden', max <= 1);
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
